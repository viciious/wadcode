        while True:
            uniqs, cnt = crunchpatches(uniqs, minthreshold=minthreshold, max_workers=threads)
            if minthreshold == 16:
                break
            if cnt != 0:
                continue
            minthreshold = int(minthreshold * 0.75)
            if minthreshold < 16:
                minthreshold = 16

