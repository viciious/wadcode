def squishpatches(uniqs = {}):
    global s_endname
    global s_startname

    totalsaved = 0

    _, s_start = findcontent(content, s_startname)
    _, s_end = findcontent(content, s_endname)

    sha1uniqs = {}
    nameuniqs = {}
    sha1s = [''] * len(content)

    i = s_start
    if "filename" not in content[i]:
        i = i + 1
    while i < s_end:
        fn = content[i]["filename"]
        pixels = diskfn(content[i+1]["filename"])

        for tfn in [pixels]:
            sha1 = hashlib.sha1()
            data = b""
            with open(tfn, "rb") as f:
                data = f.read()
            sha1 = hashlib.sha1()
            sha1.update(data)
            sha1 = sha1.hexdigest()

            name = content[i]["name"][:4]
            if name not in nameuniqs:
                nameuniqs[name] = sha1

            if sha1 not in sha1uniqs:
                sha1uniqs[sha1] = [i]
            else:
                sha1uniqs[sha1].append(i)
            sha1s[i] = sha1

        i = i + 2

    for k in sha1uniqs:
        patches = sha1uniqs[k]
        if len(patches) >= 2:
            continue

        patch = patches[0]
        name = content[patch]["name"][:4]
        sha1 = nameuniqs[name]
        sha1uniqs[sha1].append(patch)

    for k in sha1uniqs:
        patches = sha1uniqs[k]
        if len(patches) < 2:
            continue

        batch = list()
        coluniqs = {}

        n = len(patches) - 1
        while n >= 0:
            patch = patches[n]
            fn = content[patch]["filename"]
            width, height, offs, columnofs, columns = readpatch(diskfn(fn))
            ofs = 8 + width * 2
            patchlen = ofs

            rawcolumns = buildrawcolumns(width, columns)

            for i in range(width):
                raw = rawcolumns[i]
                data = tuple(raw)
                if data not in coluniqs:
                    uniqparts = []

                    m = collen(raw)
                    while m < len(raw):
                        data = tuple(raw[m:])
                        if data not in coluniqs:
                            uniqparts.append(data)
                            coluniqs[data] = (n, patchlen+m, [])
                        m = m + collen(raw[m:])

                    data = tuple(raw)
                    coluniqs[data] = (n, patchlen, uniqparts)
                    patchlen = patchlen + len(raw)
                ofs = ofs + len(raw)

            batch.append((width, height, offs, columnofs, rawcolumns, patch, ofs, patchlen, 0))

            n = n - 1
            totalsaved = totalsaved + (ofs - patchlen)

        # reverse order
        patches = []
        bloblen = 0
        for n in range(len(batch)):
            patch = list(batch.pop())
            patch[8] = bloblen
            patchlen = patch[7]
            if patchlen & 1:
                patchlen = patchlen + 1
            bloblen = bloblen + patchlen
            patches.append(tuple(patch))

        # distances from each patch to other patches
        dists = [0]*len(patches)
        for n in range(len(patches)):
            pos = patches[n][8]
            dists[n] = [0]*len(patches)
            for j in range(len(patches)):
                dists[n][j] = patches[j][8] - pos

        for n, patch in enumerate(patches):
            fn = content[patch[5]]["filename"]
            fin = diskfn(fn)

            with open(fin, "wb") as f:
                m = n
                while m < len(patches):
                    written = {}
                    patch = patches[m]
                    width, height, offs, columnofs, rawcolumns, _, _, patchlen, _ = patch

                    flen = f.tell()

                    for i in range(width):
                        data = tuple(rawcolumns[i])
                        u = coluniqs[data]
                        colofs = dists[m][u[0]]
                        if colofs & 1:
                            colofs = colofs + 1
                        colofs = colofs + u[1]
                        columnofs[i] = colofs

                    newrawcolumns = []
                    for i in range(width):
                        data = tuple(rawcolumns[i])
                        u = coluniqs[data]

                        if u[0] == m and data not in written:
                            newrawcolumns.append(rawcolumns[i])
                            written[data] = True
                            for part in u[2]:
                                written[part] = True

                    writerawpatchfile(f, width, height, offs, columnofs, newrawcolumns)

                    flen = f.tell() - flen
                    if flen != patchlen:
                        print(fin)
                        print(flen, patchlen)
                        sys.exit(1)
                    if patchlen & 1:
                        writeu8(f, 255)
                    m = m + 1

    print("total\t\t%s" % totalsaved)

def merge_pixel_runs_scs(runs):
    """
    Optimized Greedy Shortest Common Superstring (SCS) implementation.
    Maximizes suffix-to-prefix overlap while correctly maintaining exact offsets.
    """
    if not runs:
        return bytearray(), {}

    # Deduplicate while preserving original run identities
    unique_runs = tuple(set(runs))
    num_runs = len(unique_runs)
    
    if num_runs == 1:
        return bytearray(unique_runs[0]), {unique_runs[0]: 0}

    # Pre-convert sequences to bytes for fast execution and slice matching
    nodes = [bytes(r) for r in unique_runs]

    # Pre-calculate all non-zero suffix-to-prefix overlaps O(N^2 * L)
    # Stores (overlap_len, src_index, dst_index)
    overlaps = []
    for i in range(num_runs):
        node_i = nodes[i]
        len_i = len(node_i)
        for j in range(num_runs):
            if i == j:
                continue
            node_j = nodes[j]
            max_len = min(len_i, len(node_j))
            # Check overlaps from longest to shortest
            for length in range(max_len, 0, -1):
                if node_i[-length:] == node_j[:length]:
                    overlaps.append((length, i, j))
                    break

    # Sort overlaps descending by length
    overlaps.sort(key=lambda x: x[0], reverse=True)

    # Disjoint-set / Path-linking tracking to prevent cycles
    parent = list(range(num_runs))
    next_node = [-1] * num_runs
    prev_node = [-1] * num_runs

    def find_root(i):
        path = []
        while parent[i] != i:
            path.append(i)
            i = parent[i]
        for node in path:
            parent[node] = i
        return i

    # Greedy merging phase: O(N^2)
    for ov, i, j in overlaps:
        if next_node[i] != -1 or prev_node[j] != -1:
            continue
        
        root_i = find_root(i)
        root_j = find_root(j)
        
        # Avoid forming loops
        if root_i != root_j:
            next_node[i] = (j, ov)
            prev_node[j] = i
            parent[root_j] = root_i

    # Assemble concatenated path chains and compute exact offsets
    merged_bytes = bytearray()
    offsets = {}
    visited = [False] * num_runs

    for i in range(num_runs):
        if prev_node[i] == -1 and not visited[i]:
            curr = i
            chain_start_offset = len(merged_bytes)
            
            while curr != -1:
                visited[curr] = True
                curr_node = nodes[curr]
                
                # Assign exact starting position in the merged bytearray
                offsets[unique_runs[curr]] = len(merged_bytes)
                
                if next_node[curr] != -1:
                    nxt, ov = next_node[curr]
                    merged_bytes.extend(curr_node[:-ov])
                    curr = nxt
                else:
                    merged_bytes.extend(curr_node)
                    curr = -1

    return merged_bytes, offsets


def optpixels_scs(fin, fin2):
    """
    SCS-optimized optpixels that restructures the pixel binary using graph-based
    suffix-to-prefix merging while updating column offsets.
    """
    size = os.path.getsize(fin2)
    width, height, offs, columnofs, columns = readpatch(fin)

    runs_in_use = []
    col_run_map = []  # Maps each non-255 column post index to its pixel tuple

    with open(fin2, "rb") as f2:
        pixels = mmap.mmap(f2.fileno(), 0, access=mmap.ACCESS_COPY)

        j = 0
        while j < len(columns):
            topdelta, length, dataofs = columns[j]
            if topdelta != 255:
                run = tuple(pixels[dataofs:dataofs + length])
                runs_in_use.append(run)
                col_run_map.append((j, topdelta, length, run))
            j += 1

        pixels.close()

    # Generate the merged pixel buffer using SCS overlap
    newpixels, run_offsets = merge_pixel_runs_scs(runs_in_use)

    # Update columns with their new offset in the merged pixel buffer
    for col_idx, topdelta, length, run in col_run_map:
        new_dataofs = run_offsets[run]
        columns[col_idx] = (topdelta, length, new_dataofs)

    # Rebuild patch headers and output files
    rawcolumns = buildrawcolumns(width, columns)
    newofs = 8 + width * 2
    for i in range(width):
        columnofs[i] = newofs
        newofs = newofs + len(rawcolumns[i])

    writepatch(fin, width, height, offs, columnofs, columns)
    writepixels(fin2, newpixels)

    saved = size - os.path.getsize(fin2)
    if saved > 0:
        print("%s\t%s" % (fin2, saved))
    return saved

def _process_single_patch_scs(item):
    """
    Helper worker function to process a single patch/pixel pair.
    Returns (filename, saved_bytes).
    """
    fn, patch, pixels = item
    print("SCS-optimizing pixels for %s" % fn)
    saved = optpixels_scs(patch, pixels)
    return fn, saved

def optpixelsscs_all(max_workers=None):
    """
    Multi-threaded version of optpixelsscs_all.
    max_workers defaults to CPU core count if set to None.
    """
    global s_endname
    global s_startname

    _, s_start = findcontent(content, s_startname)
    _, s_end = findcontent(content, s_endname)

    # Collect all tasks (file pairs) first
    tasks = []
    i = s_start
    if "filename" not in content[i]:
        i = i + 1
    while i < s_end:
        fn = content[i]["filename"]
        patch = diskfn(fn)
        pixels = diskfn(content[i+1]["filename"])
        tasks.append((fn, patch, pixels))
        i = i + 2

    totalpix = 0

    # Process patch files in parallel using a ThreadPoolExecutor
    with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as executor:
        futures = [executor.submit(_process_single_patch_scs, task) for task in tasks]
        
        for future in concurrent.futures.as_completed(futures):
            try:
                fn, saved = future.result()
                totalpix += saved
            except Exception as exc:
                print("Error processing patch: %s" % exc)

    print("total saved\t%s" % totalpix)

