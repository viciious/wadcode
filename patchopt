dirname = ""
content = ""
s_startname = "S_START"
s_endname = "S_END"

def diskfn(fn):
    return os.path.join(dirname, fn)

def readu16(f):
    return int.from_bytes(f.read(2), "big", signed=False)

def readu32(f):
    return int.from_bytes(f.read(4), "big", signed=False)

def readu8(f):
    return int.from_bytes(f.read(1), "big", signed=False)

def eu8(v):
    return (v.to_bytes(1, "big", signed=False))

def ebu16(v):
    return (v.to_bytes(2, "big", signed=False))

def ebu32(v):
    return (v.to_bytes(4, "big", signed=False))

def writeu8(f, v):
    f.write(eu8(v))

def writebu16(f, v):
    f.write(ebu16(v))

def writebu32(f, v):
    f.write(ebu32(v))

def collen(col):
    topdelta = col[0]
    if topdelta == 255:
        return 1
    length = col[1]
    if length == 0:
        return 2
    return 4

def readpatchfile(f, newfmt=True, debug=False):
    width = readu16(f)
    height = 0
    if not newfmt:
        height = readu16(f)
    offs = readu32(f)
    columnofs = []
    columns = []

    for i in range(width):
        columnofs.append(readu16(f))
    
    for i in range(width):
        f.seek(columnofs[i])
        while True:
            topdelta = readu8(f)
            if newfmt and topdelta == 255:
                columns.append((255, 255, 0))
                break
            length = readu8(f)
            stop = False
            if newfmt:
                stop = length & 0x80
                length = length & 0x7F
                length = length + 1
            if topdelta == 255 or length == 0:
                columns.append((255, 255, 0))
                break
            ofs = readu16(f)
            columns.append((topdelta, length, ofs))
            if stop:
                columns.append((255, 255, 0))
                break
    return (width, height, offs, columnofs, columns)

def readpatch(fin, newfmt=True, debug=False):
    with open(fin, "rb") as f:
        return readpatchfile(f, newfmt, debug)
    return (0, 0, 0, None, None)

def buildrawcolumns(width, columns):
    rawcolumns = []
    j = 0
    for i in range(width):
        raw = bytearray()
        while j < len(columns):
            col, j = columns[j], j + 1
            if col[0] == 255:
                raw.append(255)
                break
            if col[1] == 0:
                continue

            nextlast = False
            if j == len(columns):
                nextlast = True
            if not nextlast:
                nextcol = columns[j]
                if nextcol[0] == 255:
                    nextlast = True

            topdelta = col[0]
            length = col[1]-1
            offset = col[2]
            offset = ebu16(offset)

            if nextlast:
                raw.append(topdelta)
                raw.append(length|128)
                raw.extend(offset)
                j = j + 1
                break
            else:
                raw.append(topdelta)
                raw.append(length)
                raw.extend(offset)
        rawcolumns.append(bytes(raw))
    return rawcolumns

def writerawpatchfile(f, width, height, offs, columnofs, rawcolumns, trailer=b""):
    writebu16(f, width)
    #writebu16(f, height)
    writebu32(f, offs)

    for i in range(width):
        writebu16(f, columnofs[i])
    for c in rawcolumns:
        f.write(c)
    f.write(trailer)

def writepatchfile(f, width, height, offs, columnofs, columns):
    writerawpatchfile(f, width, height, offs, columnofs, buildrawcolumns(width, columns))

def writepatch(fin, width, height, offs, columnofs, columns, mode="wb"):
    with open(fin, mode) as f:
        writepatchfile(f, width, height, offs, columnofs, columns)

def writepixels(fin, pixels):
    with open(fin, "wb") as f:
        f.write(pixels)

def allsubcols(uniqcols):
    res = {}
    for c in uniqcols:
        res[c] = uniqcols[c]
    
    for pixels in uniqcols:
        col = uniqcols[pixels]
        collen = len(pixels)
        if collen == 1:
            continue
        for i in range(collen-1):
            subpixels = pixels[i+1:]
            if subpixels not in res:
                res[subpixels] = (col[0], collen-i-1, col[2]+i+1)

    return res

def optpatch(fin, fin2):
    origsize = os.path.getsize(fin)
    width, height, offs, columnofs, columns = readpatch(fin, False)

    uniqcols = {}
    with open(fin2, "rb") as f2:
        pixels = mmap.mmap(f2.fileno(), 0, access=mmap.ACCESS_COPY)

        j = 0
        for i in range(width):
            while j < len(columns):
                topdelta, length, dataofs = columns[j]
                if topdelta == 255:
                    j = j + 1
                    break

                data = pixels[dataofs:dataofs+length]

                x = uniqcols.get(data)
                if x:
                    if x[2] != dataofs:
                        columns[j] = (columns[j][0], columns[j][1], x[2])
                else:
                    uniqcols[data] = (topdelta, length, dataofs)
                    if length > 1:
                        for i in range(length-1):
                            subpixels = pixels[dataofs+i+1:dataofs+length]
                            if subpixels not in uniqcols:
                                uniqcols[subpixels] = (topdelta, length-i-1, dataofs+i+1)
                j = j + 1

        pixels.close()

        rawcolums = buildrawcolumns(width, columns)
        newofs = 6 + width * 2
        for i in range(width):
            columnofs[i] = newofs
            newofs = newofs + len(rawcolums[i])

    writepatch(fin, width, height, offs, columnofs, columns)

    saved = origsize - os.path.getsize(fin)
    if saved > 0:
        print("%s\t%s" % (fin, saved))
    return saved

def optpixels(fin, fin2):
    size = os.path.getsize(fin2)
    width, height, offs, columnofs, columns = readpatch(fin)
    offsets = {}

    with open(fin2, "rb") as f2:
        pixels = mmap.mmap(f2.fileno(), 0, access=mmap.ACCESS_COPY)

        j = 0
        while j < len(columns):
            topdelta, length, dataofs = columns[j]
            if topdelta != 255:
                if dataofs in offsets:
                    l = offsets[dataofs]
                    if length > l:
                        offsets[dataofs] = length
                else:
                    offsets[dataofs] = length
            j = j + 1
        offsets = [(k,v) for k,v in offsets.items()]
        used = sorted(offsets, key=lambda x: x[0])

        i = 0
        while i < len(used)-1:
            pos, length = used[i]
            nextpos, nextlength = used[i+1]
            if pos+length > nextpos:
                used = used[0:i] + used[i+1:]
                used[i] = (pos, nextpos+nextlength-pos)
                i = i - 1
            i = i + 1

        newpixels = bytearray()

        offset = 0
        k = 0
        origused = used.copy()
        while k < len(used):
            o, l = used[k]
            oo, ol = origused[k]
            if l > 0 and offset < o:
                j = 0
                while j < len(columns):
                    topdelta, length, dataofs = columns[j]
                    if topdelta != 255 and dataofs >= o:
                        columns[j] = (topdelta, length, dataofs - (o - offset))
                    j = j + 1
                j = k
                while j < len(used):
                    used[j] = (used[j][0] - (o - offset), used[j][1])
                    j = j + 1

            newpixels = newpixels + pixels[oo:oo+ol]
            offset = offset + l
            k = k + 1

        pixels.close()
         
    rawcolums = buildrawcolumns(width, columns)
    newofs = 6 + width * 2
    for i in range(width):
        columnofs[i] = newofs
        newofs = newofs + len(rawcolums[i])

    writepatch(fin, width, height, offs, columnofs, columns)
    writepixels(fin2, newpixels)

    saved = size - os.path.getsize(fin2)
    if saved > 0:
        print("%s\t%s" % (fin2, saved))
    return saved

def findcontent(content, name):
    ind = 0
    for e in content:
        if "name" in e:
            if e["name"] == name:
                return (e, ind)
        ind = ind + 1
    return (None, -1)

def patchuniqs(fin, fin2):
    width, height, offs, columnofs, columns = readpatch(fin)
    uniqcols = {}

    with open(fin2, "rb") as f2:
        pixels = mmap.mmap(f2.fileno(), 0, access=mmap.ACCESS_COPY)

        j = 0
        for i in range(width):
            while j < len(columns):
                topdelta, length, dataofs = columns[j]
                j = j + 1

                if topdelta == 255:
                    break

                data = pixels[dataofs:dataofs+length]
                if data not in uniqcols:
                    uniqcols[data] = (topdelta, length, dataofs)

        pixels.close()

    return uniqcols

def mergepatches(pixfn, uniqcols, fin, fin2):
    fullpix, partialpix = 0, 0
    origsize = os.path.getsize(pixfn)
    width, height, offs, columnofs, columns = readpatch(fin)

    subcols = allsubcols(uniqcols)
    with open(pixfn, "ab") as f3:
        with open(fin2, "rb") as f2:
            pixels = mmap.mmap(f2.fileno(), 0, access=mmap.ACCESS_COPY)

            j = 0
            for i in range(width):
                while j < len(columns):
                    topdelta, length, dataofs = columns[j]

                    if topdelta == 255:
                        columns[j] = (topdelta, length, origsize)
                        j = j + 1
                        break

                    data = pixels[dataofs:dataofs+length]
                    x = subcols.get(data)
                    if not x:
                        uniqcols[data] = (topdelta, length, origsize)
                        subcols[data] = (topdelta, length, origsize)
                        f3.write(data)
                        columns[j] = (topdelta, length, origsize)
                        origsize += len(data)
                    else:
                        if uniqcols.get(data):
                            fullpix += length
                        else:
                            partialpix += length
                        columns[j] = (topdelta, length, x[2])

                    j = j + 1

            pixels.close()

        rawcolums = buildrawcolumns(width, columns)
        newofs = 6 + width * 2
        for i in range(width):
           columnofs[i] = newofs
           newofs = newofs + len(rawcolums[i])
    writepatch(fin, width, height, offs, columnofs, columns)

    return (uniqcols, fullpix, partialpix)

def hash_col(col_bytes):
    return int.from_bytes(hashlib.sha1(col_bytes).digest()[:4], "big")

def crunchpatches(uniqs = {}, minthreshold=0, maxthreshold=0, skipsize=False):
    global s_endname
    global s_startname

    totalpix = 0
    totalcnt = 0

    _, s_start = findcontent(content, s_startname)
    _, s_end = findcontent(content, s_endname)

    sha1uniqs = {}
    sha1s = [''] * len(content)

    i = s_start
    if "filename" not in content[i]:
        i = i + 1

    while i < s_end:
        fn = content[i]["filename"]
        patch = diskfn(fn)
        pixels = diskfn(content[i+1]["filename"])

        j = 0
        for tfn in [patch, pixels]:
            with open(tfn, "rb") as f:
                sha1 = hashlib.sha1(f.read()).hexdigest()

            if sha1 not in sha1uniqs:
                sha1uniqs[sha1] = 1
            else:
                sha1uniqs[sha1] += 1

            sha1s[i+j] = sha1
            j = j + 1

        if fn not in uniqs:
            cols = patchuniqs(patch, pixels)
            # Store map of {32bit_hash: length} to save memory while preserving length info
            hash_lens = {hash_col(k): len(k) for k in cols.keys()}
            uniqs[fn] = (False, cols, [], frozenset(hash_lens.keys()), hash_lens)

        i = i + 2

    # --- Memory-Efficient Hash Inverted Index ---
    # Maps 32-bit hash -> list of patch indices
    col_to_patches = {}
    i = s_start
    if "filename" not in content[i]:
        i = i + 1

    while i < s_end:
        fn = content[i]["filename"]
        mapped, cols, pixfns, hash_fset, _ = uniqs[fn]
        if not mapped:
            for h in hash_fset:
                if h not in col_to_patches:
                    col_to_patches[h] = []
                col_to_patches[h].append(i)
        i = i + 2

    i = s_start
    if "filename" not in content[i]:
        i = i + 1

    while i < s_end:
        fn = content[i]["filename"]
        pixfn = diskfn(content[i+1]["filename"])
        pixfnsize = os.path.getsize(pixfn)

        mapped, cols, pixfns, hash_fset, hash_lens = uniqs[fn]

        if mapped:
            i = i + 2
            continue

        bestpix = minthreshold - 1
        bestmatch = -1
        bestcols = None

        # Gather candidate patch indices using 32-bit integer keys
        candidates = set()
        for h in hash_fset:
            if h in col_to_patches:
                for cand_idx in col_to_patches[h]:
                    if cand_idx > i:
                        candidates.add(cand_idx)

        for j in candidates:
            fn2 = content[j]["filename"]
            pixfnsize2 = os.path.getsize(diskfn(content[j+1]["filename"]))

            if pixfnsize + pixfnsize2 > 62 * 1024:
                continue

            if fn2 == fn:
                continue

            mapped2, cols2, pixfns2, hash_fset2, _ = uniqs[fn2]

            if mapped2 or len(pixfns2) > 0:
                continue

            # Intersect 32-bit hashes & sum exact length from hash_lens dict
            shared_hashes = hash_fset & hash_fset2
            pix = sum(hash_lens[h] for h in shared_hashes)

            if pix > bestpix:
                patch = diskfn(content[j]["filename"])
                patch_size2 = os.path.getsize(patch)

                if skipsize or sha1uniqs[sha1s[j]] == 1 or pix > patch_size2:
                    bestpix = pix
                    bestmatch = j
                    bestcols = cols2

        if bestpix >= minthreshold and (maxthreshold == 0 or bestpix < maxthreshold):
            totalcnt = totalcnt + 1
            fn2 = content[bestmatch]["filename"]
            pixfn2 = diskfn(content[bestmatch+1]["filename"])

            cols, fullpix, partialpix = mergepatches(pixfn, cols, diskfn(fn2), pixfn2)
            print("merged %s into %s: %s/%s pixels in full/partial columns" % (fn, fn2, fullpix, partialpix))

            totalpix = totalpix + fullpix + partialpix

            pixfns.append(pixfn2)
            pixfns = pixfns + uniqs[fn2][2]

            # Rebuild hash structures after merge
            hash_lens = {hash_col(k): len(k) for k in cols.keys()}
            hash_fset = frozenset(hash_lens.keys())

            uniqs[fn2] = (True, bestcols, [], frozenset(), {})
            uniqs[fn] = (False, cols, pixfns, hash_fset, hash_lens)

            # Update index
            for h in hash_fset:
                if h not in col_to_patches:
                    col_to_patches[h] = []
                if i not in col_to_patches[h]:
                    col_to_patches[h].append(i)

            with open(pixfn, "rb") as fin_file:
                pixels_data = fin_file.read()
                for pixfn2_path in pixfns:
                    with open(pixfn2_path, "wb") as fout_file:
                        fout_file.write(pixels_data)

        i = i + 2

    print("total\t\t%s" % totalpix)

    return uniqs, totalcnt

